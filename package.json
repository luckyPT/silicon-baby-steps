{
  "name": "silicon-baby-steps",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "硅基学步：文章、视频、三维规划算法实验室",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4173",
